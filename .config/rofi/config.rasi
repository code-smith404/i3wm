@theme "catppuccin-mocha"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    disable-history: false;
    sidebar-mode: false;
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
}


* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: #1e1e2e;
    text-color: #cdd6f4;
    border-color: #cba6f7;
    selected-background: #cba6f7;
    selected-text-color: #1e1e2e;
    spacing: 0;
    margin: 0;
    padding: 0;
}

window {
    width: 40%;
    border: 2px;
    border-radius: 12px;
    padding: 12px;
}

listview {
    lines: 10;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px;
    border-radius: 8px;
}

element selected {
    background-color: #cba6f7;
    text-color: #1e1e2e;
}
